# ===================================================
# AI TRADING TERMINAL — ENVIRONMENT CONFIGURATION
# ===================================================
# Port server backend Express (Default: 3001)
PORT=3001

# Node environment mode: 'production' atau 'development'
NODE_ENV=production

# Optional: 32-byte key for AES-256-GCM encryption of credentials at rest
# (64 hex characters or base64). If unset, a key is generated once at
# data/.encryption-key with mode 0600. When both are present, this env value
# takes precedence. Keep the key backed up separately from the database:
# without it, stored secrets cannot be decrypted.
# AI_TRADING_ENCRYPTION_KEY=

# Optional: comma-separated public RSS feed URLs (max 5) to include in the AI
# research swarm. Only http(s) URLs are accepted. Example:
# AI_TRADING_EXTRA_RSS_FEEDS=https://www.reddit.com/r/CryptoCurrency/.rss

# --- Observability (optional) ---
# Structured JSON logging via pino. Enable with AI_TRADING_STRUCTURED_LOGS=1
# (console output stays plain unless this is set). LOG_LEVEL: error|warn|info|debug.
# AI_TRADING_STRUCTURED_LOGS=1
# LOG_LEVEL=info
# Optional: also append logs to a file (logrotate is recommended).
# LOG_FILE=/var/log/ai-trading/app.log
# Optional: external uptime watchdog (healthchecks.io and compatible pinging
# services). Pinged once per minute after a successful engine loop; if the
# ping stops, the monitor alerts you that the bot stopped protecting positions.
# WATCHDOG_URL=https://hc-ping.com/<your-uuid>
