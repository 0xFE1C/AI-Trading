{
  "name": "ai-trading",
  "version": "1.0.0",
  "description": "Autonomous AI Crypto Trading Platform for Indodax",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "server": "tsx src/server.ts",
    "client": "npm --prefix client run dev",
    "dev": "tsx src/server.ts",
    "test": "tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && npm --prefix client run build",
    "optimize": "tsx scripts/optimize_strategy.ts",
    "db:reset": "tsx scripts/init_fresh_db.ts",
    "admin:token": "tsx scripts/show_admin_token.ts",
    "test:coverage": "c8 --include=src --reporter=text --reporter=lcov npm test",
    "test:coverage:critical": "c8 --include=src/services/trading/riskGuard.ts --include=src/services/security/secrets.ts --include=src/utils/indicators.ts --include=src/services/signals --check-coverage --lines 80 --reporter=text npm test"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.14",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.21.0",
    "untun": "^0.2.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "typescript": "^6.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
